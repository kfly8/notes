---
import Layout from '../../layouts/Layout.astro'
import { tagPath } from '../../lib/markdown-text'
import { loadNotes } from '../../lib/notes'

const { tags } = await loadNotes()
---

<Layout title="タグ" description="ノートに付けられたタグの一覧">
  <h1 class="page-title">タグ</h1>
  <ul class="tag-cloud">
    {
      tags.map((entry) => (
        <li>
          <a class="tag-pill" href={tagPath(entry.tag)}>
            #{entry.tag}
            <span class="count">{entry.notes.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
