{
  "name": "notes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,server -c blue,green \"vite build --watch\" \"bun --watch src/server/dev.ts\"",
    "build": "bun scripts/build-site.ts",
    "preview": "$npm_execpath run build && wrangler dev",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "check": "tsc --noEmit",
    "notes:sync": "bun run scripts/sync-notes-frontmatter.ts",
    "notes:sync:all": "bun run scripts/sync-notes-frontmatter.ts --all",
    "notes:check": "bun run scripts/check-notes-frontmatter.ts"
  },
  "dependencies": {
    "@barefootjs/client": "^0.35.7",
    "@barefootjs/jsx": "^0.35.7",
    "@barefootjs/router": "^0.35.7",
    "@barefootjs/vite": "^0.35.7",
    "github-slugger": "^2.0.0",
    "hono": "^4.13.7",
    "satteri": "^0.9.5",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.5",
    "typescript": "^6",
    "vite": "^6.0.0",
    "wrangler": "^4.123.0"
  }
}
